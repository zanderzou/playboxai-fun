---
import BaseLayout from "./BaseLayout.astro";
interface Props { title: string; description: string; kicker: string; }
const { title, description, kicker } = Astro.props;
const seoTitle = title === "About Playbox AI Video Guide" ? "About | Playbox AI" : `${title} | Playbox AI`;
---
<BaseLayout title={seoTitle} description={description}>
  <section class="info-hero"><div class="ambient-orb"></div><span>{kicker}</span><h1>{title}</h1><p>{description}</p><small>Last updated: September 20, 2026</small></section>
  <article class="info-content"><slot /></article>
</BaseLayout>
