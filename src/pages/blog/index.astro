---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { site } from "../../data/site";
const posts = (await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
const jsonLd={"@context":"https://schema.org","@type":"CollectionPage",name:"Playbox AI VS comparisons",url:`${site.url}/blog/`,description:"Five focused Playbox AI comparison guides covering features, strengths, weaknesses, cost, privacy, and best fit.",hasPart:posts.map((post)=>({"@type":"Article",headline:post.data.title,url:`${site.url}/blog/${post.id}/`,datePublished:post.data.publishDate.toISOString()}))};
---
<BaseLayout title="Playbox AI Comparisons: Five Detailed VS Guides" description="Compare Playbox AI with Musebox AI, Runway, Kling AI, Pika, Luma Dream Machine using practical strengths, weaknesses, privacy, cost, and workflow tests." keywords={["Playbox AI comparison","Playbox AI vs","Playbox AI alternatives","best Playbox AI alternative"]} jsonLd={jsonLd}>
  <section class="page-hero"><div class="ambient-orb"></div><span>PLAYBOX AI COMPARISON LIBRARY</span><h1>Five useful VS guides.<br />One repeatable test.</h1><p>Detailed Playbox AI comparisons focused on real differences, advantages, disadvantages, cost, privacy, and the user each product suits.</p></section>
  <section class="section blog-list"><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index} />)}</div></section>
</BaseLayout>
