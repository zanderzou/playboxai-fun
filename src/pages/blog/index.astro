---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { site } from "../../data/site";
const posts = (await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
const jsonLd={"@context":"https://schema.org","@type":"CollectionPage",name:"Playbox AI video comparisons and safety guides",url:`${site.url}/blog/`,description:"Independent Playbox AI image-to-video comparisons, workflow tests, credit analysis, consent checks, and privacy guidance.",hasPart:posts.map((post)=>({"@type":"Article",headline:post.data.title,url:`${site.url}/blog/${post.id}/`,datePublished:post.data.publishDate.toISOString()}))};
---
<BaseLayout title="Playbox AI Blog: Reviews, Alternatives & Safety" description="Independent Playbox AI guides covering image-to-video workflow, credits, pricing questions, consent, privacy, Musebox, Runway, and alternatives." keywords={["Playbox AI blog","Playbox AI review","Playbox alternatives","Playbox AI safety"]} jsonLd={jsonLd}>
  <section class="page-hero"><div class="ambient-orb"></div><span>PLAYBOX AI TEST LAB</span><h1>Test the motion.<br />Count the keepers.</h1><p>Original Playbox AI comparisons and practical safety guides for evaluating image-to-video tools with one repeatable scorecard.</p></section>
  <section class="section blog-list"><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index} />)}</div></section>
</BaseLayout>
