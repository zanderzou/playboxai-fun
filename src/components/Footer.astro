---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { site } from "../data/site";
import { homeCopy } from "../data/localized-playbox";
import { footerCopy } from "../data/localized-ui";
import { localizedComparisons, articleOrder } from "../data/localized-articles";
import type { SiteLocale } from "../data/locale-routes";
interface Props { posts: CollectionEntry<"blog">[]; locale: SiteLocale; }
const { posts, locale } = Astro.props;
const root = locale === "en" ? "/" : `/${locale}/`;
const ui = locale === "en" ? { workflow:"Playbox workflow",compare:"Tool comparisons",safety:"Safety checklist",official:"Official website",articles:"Blog",about:"About",privacy:"Privacy" } : homeCopy[locale].ui;
const labels = locale === "en" ? { explore:"Explore",information:"Information",latest:"Latest guides",independent:"Independent publication · Adults only",noUploads:"No uploads or generated media collected",summary:"Independent research on Playbox AI image-to-video workflows, credits, self-only upload rules, privacy and alternatives.",terms:"Terms",editorial:"Editorial policy",contact:"Contact" } : footerCopy[locale];
---
<footer>
  <div class="footer-grid">
    <div><a class="brand" href={root}><span class="brand-icon"><Icon name="spark" /></span><strong>PLAY<span>BOX</span></strong><small>AI</small></a><p>{labels.summary}</p></div>
    <div><h3>{labels.explore}</h3><a href={`${root}#workflow`}>{ui.workflow}</a><a href={`${root}#compare`}>{ui.compare}</a><a href={`${root}#safety`}>{ui.safety}</a><a href={site.officialUrl} rel="noopener noreferrer" target="_blank">{ui.official}</a></div>
    <div><h3>{labels.latest}</h3>{locale === "en" ? posts.slice(0,3).map((post) => <a href={`/blog/${post.id}/`}>{post.data.title}</a>) : articleOrder.slice(0,3).map((key) => <a href={`${root}blog/playbox-ai-vs-${key}/`}>{localizedComparisons[locale][key].title}</a>)}</div>
    <div><h3>{labels.information}</h3><a href={`${root}about/`}>{ui.about}</a><a href={`${root}privacy/`}>{ui.privacy}</a><a href={`${root}terms/`}>{labels.terms}</a><a href={`${root}editorial-policy/`}>{labels.editorial}</a><a href={`${root}contact/`}>{labels.contact}</a></div>
  </div>
  <div class="footer-bottom"><span>© <span data-year>2026</span> Playbox AI</span><span>{labels.independent}</span><span>{labels.noUploads}</span></div>
</footer>
